// ============================================================================
// Prisma Schema - Sistema de Gestion de Taller Mecanico
//
// NOTA DE VERSION: el proyecto fija "prisma" y "@prisma/client" en 6.19.2
// (ver package.json) a proposito. Desde Prisma ORM v7 (nov. 2025), los campos
// "url" y "directUrl" del bloque datasource fueron RETIRADOS del schema y
// movidos a un archivo aparte "prisma.config.ts". Mientras se siga usando
// Prisma 6.x, la configuracion de conexion se mantiene aqui mismo, tal como
// esta abajo, y sigue siendo la forma recomendada por Supabase para el patron
// pooler (url) + conexion directa (directUrl).
//
// IMPORTANTE: la base de datos en Supabase YA EXISTE. Este archivo es una
// PROPUESTA inicial derivada del SRS (seccion 7, extendida a 3FN).
//
// Antes de usarlo en runtime, sincronizalo con la base real:
//   npx prisma db pull        -> trae el esquema REAL de Supabase y sobrescribe
//                                 este archivo (recomendado si la BD ya tiene datos)
//   npx prisma generate       -> genera el cliente a partir del schema resultante
//
// Si en cambio la base esta vacia y quieres partir de este diseño:
//   npx prisma migrate dev --name init
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Catalogos / soporte multi-sucursal (RNF: soporte multi-sucursal)
// ---------------------------------------------------------------------------

model Sucursal {
  id        Int       @id @default(autoincrement()) @map("id_sucursal")
  nombre    String
  direccion String?
  telefono  String?
  activo    Boolean   @default(true)
  usuarios  Usuario[]
  ordenes   OrdenTrabajo[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("sucursales")
}

model Rol {
  id       Int       @id @default(autoincrement()) @map("id_rol")
  nombre   String    @unique // recepcionista | mecanico | supervisor | administrador
  usuarios Usuario[]

  @@map("roles")
}

// ---------------------------------------------------------------------------
// RF-08 Gestion de Usuarios
// ---------------------------------------------------------------------------

model Usuario {
  id           Int      @id @default(autoincrement()) @map("id_usuario")
  nombre       String
  email        String   @unique
  passwordHash String   @map("password_hash")
  rolId        Int      @map("id_rol")
  sucursalId   Int?     @map("id_sucursal")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rol               Rol            @relation(fields: [rolId], references: [id])
  sucursal          Sucursal?      @relation(fields: [sucursalId], references: [id])
  ordenesAsignadas  OrdenTrabajo[] @relation("MecanicoAsignado")

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// RF-01 Gestion de Clientes
// ---------------------------------------------------------------------------

model Cliente {
  id                 Int      @id @default(autoincrement()) @map("id_cliente")
  tipoCliente        String   @map("tipo_cliente") // natural | juridico
  tipoIdentificacion String   @map("tipo_identificacion") // cedula | RNC | pasaporte
  identificacion     String   @unique
  nombre             String
  telefono           String?
  direccion          String?
  email              String?  @unique
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  vehiculos      Vehiculo[]
  ordenesTrabajo OrdenTrabajo[]
  citas          Cita[]

  @@map("clientes")
}

// ---------------------------------------------------------------------------
// RF-02 Gestion de Vehiculos (cada vehiculo pertenece a un cliente)
// ---------------------------------------------------------------------------

model Vehiculo {
  id         Int      @id @default(autoincrement()) @map("id_vehiculo")
  clienteId  Int      @map("id_cliente")
  chasis     String   @unique
  marca      String
  modelo     String
  color      String?
  anio       Int      @map("anio")
  placa      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  ordenesTrabajo OrdenTrabajo[]
  citas          Cita[]

  @@map("vehiculos")
}

// ---------------------------------------------------------------------------
// RF-03 Ordenes de Trabajo / RF-04 Diagnostico / RF-10 Historial
// ---------------------------------------------------------------------------

enum EstadoOrden {
  ABIERTA
  EN_DIAGNOSTICO
  EN_REPARACION
  ESPERANDO_REPUESTOS
  FINALIZADA
  CERRADA
  CANCELADA
}

model OrdenTrabajo {
  id                Int         @id @default(autoincrement()) @map("id_ot")
  clienteId         Int         @map("id_cliente")
  vehiculoId        Int         @map("id_vehiculo")
  mecanicoId        Int?        @map("id_mecanico")
  sucursalId        Int?        @map("id_sucursal")
  problemaReportado String      @map("problema_reportado")
  estado            EstadoOrden @default(ABIERTA)
  fecha             DateTime    @default(now())
  fechaCierre       DateTime?   @map("fecha_cierre")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  vehiculo     Vehiculo      @relation(fields: [vehiculoId], references: [id])
  mecanico     Usuario?      @relation("MecanicoAsignado", fields: [mecanicoId], references: [id])
  sucursal     Sucursal?     @relation(fields: [sucursalId], references: [id])
  diagnosticos Diagnostico[]
  facturas     Factura[]

  @@map("ordenes_trabajo")
}

model Diagnostico {
  id             Int      @id @default(autoincrement()) @map("id_diagnostico")
  otId           Int      @map("id_ot")
  presionBaja    Decimal? @map("presion_baja") @db.Decimal(6, 2)
  presionAlta    Decimal? @map("presion_alta") @db.Decimal(6, 2)
  temperatura    Decimal? @db.Decimal(6, 2)
  fallaDetectada String   @map("falla_detectada")
  createdAt      DateTime @default(now()) @map("created_at")

  ordenTrabajo OrdenTrabajo @relation(fields: [otId], references: [id])

  @@map("diagnosticos")
}

// ---------------------------------------------------------------------------
// RF-05 Inventario
// ---------------------------------------------------------------------------

model Material {
  id             Int      @id @default(autoincrement()) @map("id_material")
  nombre         String
  descripcion    String?
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  stock          Int      @default(0)
  stockMinimo    Int      @default(0) @map("stock_minimo")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  detalleFacturas DetalleFactura[]

  @@map("materiales")
}

// ---------------------------------------------------------------------------
// RF-06 Facturacion (maestro-detalle)
// ---------------------------------------------------------------------------

enum EstadoPago {
  PENDIENTE
  PARCIAL
  PAGADA
}

model Factura {
  id          Int        @id @default(autoincrement()) @map("id_factura")
  otId        Int        @map("id_ot")
  fecha       DateTime   @default(now())
  formaPago   String     @map("forma_pago")
  subtotal    Decimal    @db.Decimal(10, 2)
  impuesto    Decimal    @db.Decimal(10, 2)
  total       Decimal    @db.Decimal(10, 2)
  estadoPago  EstadoPago @default(PENDIENTE) @map("estado_pago")
  createdAt   DateTime   @default(now()) @map("created_at")

  ordenTrabajo OrdenTrabajo     @relation(fields: [otId], references: [id])
  detalles     DetalleFactura[]

  @@map("facturas")
}

model DetalleFactura {
  id             Int     @id @default(autoincrement()) @map("id_detalle")
  facturaId      Int     @map("id_factura")
  materialId     Int?    @map("id_material")
  descripcion    String
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)

  factura  Factura   @relation(fields: [facturaId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])

  @@map("detalle_facturas")
}

// ---------------------------------------------------------------------------
// RF-07 Agenda de Citas
// ---------------------------------------------------------------------------

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

model Cita {
  id         Int        @id @default(autoincrement()) @map("id_cita")
  clienteId  Int        @map("id_cliente")
  vehiculoId Int?       @map("id_vehiculo")
  fechaHora  DateTime   @map("fecha_hora")
  motivo     String?
  estado     EstadoCita @default(PROGRAMADA)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  cliente  Cliente   @relation(fields: [clienteId], references: [id])
  vehiculo Vehiculo? @relation(fields: [vehiculoId], references: [id])

  @@map("citas")
}
