# Puerto donde correra la API (nginx hara proxy_pass hacia este puerto)
PORT=4000
NODE_ENV=development

# --- Conexion a Supabase (PostgreSQL) ---
# DATABASE_URL: usar la cadena de "Connection pooling" (puerto 6543, pgbouncer=true)
#   -> la usa la app en tiempo de ejecucion (muchas conexiones cortas)
# DIRECT_URL: usar la cadena de "Connection string" directa (puerto 5432)
#   -> la usa Prisma solo para migrate/db pull, no para runtime
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Autenticacion ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# --- CORS (dominio del frontend ya desplegado) ---
CORS_ORIGIN=https://tu-frontend.com

# --- Proxies delante de esta app (para que req.ip refleje la IP real del cliente) ---
# 1 = solo Nginx en la misma VM.  2 = Nginx + el proxy interno de Render (u otro PaaS).
TRUST_PROXY_HOPS=1

# --- Usuario administrador semilla (opcional, usado por prisma/seed.js) ---
# Si no defines estas, el seed usa admin@taller.com / Admin12345! por defecto.
SEED_ADMIN_EMAIL=admin@taller.com
SEED_ADMIN_PASSWORD=Admin12345!
